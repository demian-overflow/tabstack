{
  "manifest_version": 3,
  "name": "Tabstack",
  "version": "0.1.0",
  "description": "A keyboard-driven stack of tabs in the Chrome side panel. Alt+F to stack the current tab, Alt+1..9 to jump back.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "storage", "sidePanel"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "action": {
    "default_title": "Tabstack",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/chord.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "commands": {
    "push-tab": {
      "suggested_key": { "default": "Alt+F" },
      "description": "Stack the current tab"
    },
    "open-panel": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Open the Tabstack side panel"
    },
    "jump-1": {
      "suggested_key": { "default": "Alt+1" },
      "description": "Jump to stack item 1"
    },
    "jump-2": {
      "suggested_key": { "default": "Alt+2" },
      "description": "Jump to stack item 2"
    },
    "jump-3": { "description": "Jump to stack item 3" },
    "jump-4": { "description": "Jump to stack item 4" },
    "jump-5": { "description": "Jump to stack item 5" },
    "jump-6": { "description": "Jump to stack item 6" },
    "jump-7": { "description": "Jump to stack item 7" },
    "jump-8": { "description": "Jump to stack item 8" },
    "jump-9": { "description": "Jump to stack item 9" },
    "pop-tab": { "description": "Remove the last stack item" }
  }
}
